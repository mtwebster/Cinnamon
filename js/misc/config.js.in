/**
 * FILE:config.js
 * @short_description: Build-time configuration constants
 *
 * Contains package name, version, and installation paths set at
 * build time by Meson. This file is generated from config.js.in.
 */

/* The name of this package (not localized) */
var PACKAGE_NAME = '@PACKAGE_NAME@';
/* The version of this package */
var PACKAGE_VERSION = '@PACKAGE_VERSION@';
/* 1 if networkmanager is available, 0 otherwise */
var BUILT_NM_AGENT = @BUILT_NM_AGENT@;
/* libexec directory */
var LIBEXECDIR = '@LIBEXECDIR@';
